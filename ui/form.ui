       </size>
      </property>
      <property name="styleSheet">
       <string notr="true">QSlider:horizontal {
    padding: 10px;
}

QSlider::groove:horizontal {
    border: 1px solid #2d2d3d;
    height: 10px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        /* Tick at 0% */
        stop:0.0 #4b4b5e, stop:0.01 #4b4b5e, stop:0.011 #1e1e24,
        /* Gap */
        stop:0.24 #1e1e24,
        /* Tick at 25% */
        stop:0.241 #4b4b5e, stop:0.25 #4b4b5e, stop:0.251 #1e1e24,
        /* Gap */
        stop:0.49 #1e1e24,
        /* Tick at 50% */
        stop:0.491 #4b4b5e, stop:0.50 #4b4b5e, stop:0.501 #1e1e24,
        /* Gap */
        stop:0.74 #1e1e24,
        /* Tick at 75% */
        stop:0.741 #4b4b5e, stop:0.75 #4b4b5e, stop:0.751 #1e1e24,
        /* Gap */
        stop:0.99 #1e1e24,
        /* Tick at 100% */
        stop:0.991 #4b4b5e, stop:1.0 #4b4b5e);
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        /* Tick at 0% (Dark Purple) */
        stop:0.0 #4b4b5e, stop:0.01 #4b4b5e, stop:0.011 #45259b,
        /* Gap blending from dark purple to mid purple */
        stop:0.24 #4a28a3,
        /* Tick at 25% */
        stop:0.241 #4b4b5e, stop:0.25 #4b4b5e, stop:0.251 #4a28a3,
        /* Gap blending toward center */
        stop:0.49 #502fb3,
        /* Tick at 50% */
        stop:0.491 #4b4b5e, stop:0.50 #4b4b5e, stop:0.501 #502fb3,
        /* Gap blending toward vibrant purple */
        stop:0.74 #5532cc,
        /* Tick at 75% */
        stop:0.741 #4b4b5e, stop:0.75 #4b4b5e, stop:0.751 #5532cc,
        /* Gap leading to the end color */
        stop:0.99 #5b36e3,
        /* Tick at 100% */
        stop:0.991 #4b4b5e, stop:1.0 #4b4b5e);
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #8b5cf6;
	border: 2px solid #8b5cf6;
    width: 14px;
    margin-top: -5px;     
    margin-bottom: -5px;
    border-radius: 8px;   
}

QSlider::ticks:horizontal {
    background: none;
    color: #4b4b5e;
    height: 5px;
}</string>
      </property>
